<mvc:View xmlns:table="sap.ui.table" controllerName="brasileirao.controller.Main"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <ObjectHeader
            title="Campeonato Brasileiro 2023 - FIoriNET"
            number="9a"
            numberUnit="Rodada"
            id="objectHeader1"
        ></ObjectHeader>
        <!-- Barra de abas com ícones-->
        <IconTabBar id="Icontabbar1">
            <!-- Agregação - elementos que se repetem dentro de um elemento superior-->
            <!-- Abas vão se repetir dentro da barra de abas-->
           <items>
                <IconTabFilter text="Classificação" 
                               key="classificacao"
                               icon="sap-icon://competitor">

                    <Table>
                        <columns>
                            <!-- Posicao -->
                            <Column><Text  text="Posição"></Text>
                            </Column>
                            <!-- Escudo-->
                            <Column><Text  text=""></Text>
                            </Column>
                            <!-- Time -->
                            <Column><Text  text="Time"></Text>
                            </Column>
                            <!-- Pontos -->
                            <Column><Text  text="Pontos"></Text>
                            </Column>
                            <!-- Partidas jogadas -->
                            <Column><Text  text="PJ"></Text>
                            </Column>
                            <!-- Vitórias -->
                            <Column><Text  text="VIT"></Text>
                            </Column>
                            <!-- Empates -->
                            <Column><Text  text="E"></Text>
                            </Column>
                            <!-- Derrotas -->
                            <Column><Text  text="DER"></Text>
                            </Column>
                            <!-- Gols marcados -->
                            <Column><Text  text="GM"></Text>
                            </Column>
                            <!-- Gols contra -->
                            <Column><Text  text="GC"></Text>
                            </Column>
                            <!-- Saldo de gols -->
                            <Column><Text  text="SG"></Text>
                            </Column>

                        </columns>
                        <!-- Linhas da tabela-->
                        <ColumnListItem >
                            <cells>
                                <!-- 1o coluna - posicao-->
                                <Text text="1"></Text>
                                <!-- Escudo -->
                                <Image 
                            src="https://upload.wikimedia.org/wikipedia/commons/thumb/5/52/Botafogo_de_Futebol_e_Regatas_logo.svg/1200px-Botafogo_de_Futebol_e_Regatas_logo.svg.png"
                            width="25%"
                            ></Image>
                            <Text text="Botafogo"></Text>
                            <!-- Pontos -->    
                            <Text text="24"></Text>
                            <!-- Partidas jogadas -->
                            <Text text="10"></Text>
                            <!-- Vitórias -->
                            <Text text="8"></Text>
                            <!-- Empates -->
                            <Text text="0"></Text>
                            <!-- Derrotas -->
                            <Text text="2"></Text>
                            <!-- GM -->
                            <Text text="18"></Text>
                            <!-- GC -->
                            <Text text="7"></Text>
                            <!-- SG -->
                            <Text text="11"></Text>
                        </cells>
                    </ColumnListItem >
                    <ColumnListItem >
                        <cells>
                            <!-- 1o coluna - posicao-->
                            <Text text="2"></Text>
                            <!-- Escudo -->
                            <Image src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/10/Palmeiras_logo.svg/1200px-Palmeiras_logo.svg.png"
                                        width="25%"
                                    ></Image>
                            <Text text="Palmeiras"></Text>
                            <!-- Pontos -->    
                            <Text text="19"></Text>
                            <!-- Partidas jogadas -->
                            <Text text="9"></Text>
                            <!-- Vitórias -->
                            <Text text="5"></Text>
                            <!-- Empates -->
                            <Text text="4"></Text>
                            <!-- Derrotas -->
                            <Text text="0"></Text>
                            <!-- GM -->
                            <Text text="20"></Text>
                            <!-- GC -->
                            <Text text="8"></Text>
                            <!-- SG -->
                            <Text text="12"></Text>
                        </cells>
                    </ColumnListItem >
                    <ColumnListItem >
                        <cells>
                            <!-- 1o coluna - posicao-->
                            <Text text="3"></Text>
                            <!-- Escudo -->
                            <Image src="https://logodownload.org/wp-content/uploads/2016/09/flamengo-logo-escudo-novo-1.png"
                                        width="25%"
                                    ></Image>
                            <Text text="Flamengo"></Text>
                            <!-- Pontos -->    
                            <Text text="19"></Text>
                            <!-- Partidas jogadas -->
                            <Text text="9"></Text>
                            <!-- Vitórias -->
                            <Text text="5"></Text>
                            <!-- Empates -->
                            <Text text="4"></Text>
                            <!-- Derrotas -->
                            <Text text="0"></Text>
                            <!-- GM -->
                            <Text text="20"></Text>
                            <!-- GC -->
                            <Text text="8"></Text>
                            <!-- SG -->
                            <Text text="12"></Text>
                        </cells>
                    </ColumnListItem >
                    <ColumnListItem >
                        <cells>
                            <!-- 1o coluna - posicao-->
                            <Text text="4"></Text>
                            <!-- Escudo -->
                            <Image src="https://logodownload.org/wp-content/uploads/2017/02/cruzeiro-logo-escudo-.png"
                                        width="25%"
                                    ></Image>
                            <Text text="Cruzeiro"></Text>
                            <!-- Pontos -->    
                            <Text text="19"></Text>
                            <!-- Partidas jogadas -->
                            <Text text="9"></Text>
                            <!-- Vitórias -->
                            <Text text="5"></Text>
                            <!-- Empates -->
                            <Text text="4"></Text>
                            <!-- Derrotas -->
                            <Text text="0"></Text>
                            <!-- GM -->
                            <Text text="20"></Text>
                            <!-- GC -->
                            <Text text="8"></Text>
                            <!-- SG -->
                            <Text text="12"></Text>
                        </cells>
                    </ColumnListItem >        
                    </Table>    
                </IconTabFilter>
                <IconTabFilter   text="Partidas" 
                            key="partidas"
                            icon="sap-icon://soccer">

                    <!-- Tabela -->
                    <Table>
                        <columns>
                            <!-- Posicao -->
                            <Column ><Text text="Posição"></Text>
                            </Column>
                        </columns>
                        <!-- Linhas da tabela-->
                        <ColumnListItem >
                            <cells>
                                <!-- 1o coluna - posicao-->
                                <Text text="2"></Text>
                            </cells>
                        </ColumnListItem >        
                    </Table>  
                </IconTabFilter>
           </items>
        </IconTabBar>
    </Page>
</mvc:View>
